# AlphaCP panel vhost — written by installer/step2b-install.sh
# Included by /etc/nginx/alpha/nginx.conf (the AlphaCP-owned wrapper) so the
# distro nginx.conf is never touched. Falls back to sites-available on
# Debian/Ubuntu when no wrapper is present.
server {
    listen 8090 ssl;
    listen [::]:8090 ssl;
    http2 on;

    server_name _;

    root @@PANEL_ROOT@@/public;
    index index.php;

    ssl_certificate     @@SSL_CERT@@;
    ssl_certificate_key @@SSL_KEY@@;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # Panel == maximum security posture: never framed, never indexed, never
    # cached (it renders per-user data), no sniffing of content types.
    add_header X-Frame-Options        "DENY"                        always;
    add_header X-Content-Type-Options "nosniff"                     always;
    add_header Referrer-Policy        "no-referrer"                  always;
    add_header X-Robots-Tag           "noindex, nofollow, noarchive" always;
    add_header Permissions-Policy     "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000"          always;

    client_max_body_size 64m;
    client_body_timeout  300s;
    keepalive_timeout    65s;

    access_log /var/log/nginx/alphacp-panel.access.log;
    error_log  /var/log/nginx/alphacp-panel.error.log;

    # Static assets — long cache, served by nginx.
    location ^~ /assets/ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; try_files $uri =404; }
    location = /robots.txt  { access_log off; log_not_found off; return 200 "User-agent: *\nDisallow: /\n"; }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass  unix:/run/php/alphacp-fpm.sock;
        fastcgi_index index.php;
        include       fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT   $realpath_root;
        fastcgi_param HTTP_PROXY      "";
        # The distro's fastcgi_params maps HTTP_HOST to $host, which DROPS the
        # port — the panel would then generate https://host/... instead of
        # https://host:8090/... (redirects land on nothing). Panels live on
        # non-standard ports, so forward the full host:port here.
        fastcgi_param HTTP_HOST       $http_host;
        fastcgi_param SERVER_PORT     $server_port;
        fastcgi_read_timeout 300s;
    }

    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
}

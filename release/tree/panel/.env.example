# AlphaCP panel — environment template (fresh install par installer isse .env banata hai)
APP_NAME=AlphaCP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
LOG_CHANNEL=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alphacp_panel
DB_USERNAME=alphacp_panel
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
ACP_AGENT_SOCKET=/run/alphacp/paneld.sock
ACP_CHECK_PWNED=true

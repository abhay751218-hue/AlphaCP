# AlphaCP panel vhost — PLAIN HTTP variant
# Written by installer/step2b-install.sh --insecure-http (dev boxes, workspace
# previews). A production server uses nginx-alphacp.conf.in (HTTPS on 8090).
server {
    listen 8090;
    listen [::]:8090;
    server_name _;

    root @@PANEL_ROOT@@/public;
    index index.php;

    # X-Frame-Options is set by the app (config acp.security.frame_options) so a
    # dev/preview box can opt out without touching nginx.
    add_header X-Content-Type-Options "nosniff"                       always;
    add_header Referrer-Policy        "no-referrer"                   always;
    add_header X-Robots-Tag           "noindex, nofollow, noarchive"  always;

    client_max_body_size 64m;
    client_body_timeout  300s;
    keepalive_timeout    65s;

    access_log /var/log/nginx/alphacp-panel.access.log;
    error_log  /var/log/nginx/alphacp-panel.error.log;

    location ^~ /assets/ { expires 7d; access_log off; try_files $uri =404; }
    location = /favicon.ico { access_log off; log_not_found off; try_files $uri =404; }
    location = /robots.txt  { access_log off; log_not_found off; return 200 "User-agent: *\nDisallow: /\n"; }

    location / { try_files $uri $uri/ /index.php?$query_string; }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass  unix:/run/php/alphacp-fpm.sock;
        fastcgi_index index.php;
        include       fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT   $realpath_root;
        fastcgi_param HTTP_HOST       $http_host;
        fastcgi_param SERVER_PORT     $server_port;
        fastcgi_read_timeout 300s;
    }

    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
}
